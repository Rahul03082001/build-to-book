# Copy to .env and fill in. `.env` is gitignored -- never commit real credentials.

# ---------------------------------------------------------------------------
# Local warehouse (docker compose up)
# ---------------------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=btb
POSTGRES_USER=btb_admin
POSTGRES_PASSWORD=change_me_locally

# Pipeline role passwords (created by warehouse/sql/roles.sql)
BTB_LOADER_PASSWORD=change_me_locally
BTB_TRANSFORMER_PASSWORD=change_me_locally
BTB_REPORTER_PASSWORD=change_me_locally
BTB_AUDITOR_PASSWORD=change_me_locally

# ---------------------------------------------------------------------------
# Data profile: demo (small, hosted) or full (5M+ MES events, local only)
# ---------------------------------------------------------------------------
BTB_PROFILE=demo
BTB_SEED=20261101

# ---------------------------------------------------------------------------
# Target schema. Use `sandbox` for risky changes -- never `reporting` directly.
# ---------------------------------------------------------------------------
BTB_TARGET_SCHEMA=reporting

# ---------------------------------------------------------------------------
# Hosted demo (GitHub Actions secrets in CI; see docs/architecture.md)
# ---------------------------------------------------------------------------
# BTB_HOSTED_DSN=postgresql://user:pass@host/db?sslmode=require
